NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_organization
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

COLLEGE_EMAIL_DOMAIN=nirmauni.ac.in
FILE_STORAGE_PATH=./storage

# Optional: Razorpay test keys (mock payments are enabled by default for demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Optional local Odoo CRM integration. See /odoo_integration.md.
ODOO_ENABLED=false
ODOO_URL=http://127.0.0.1:8069
ODOO_WEB_URL=http://127.0.0.1:8069
ODOO_DATABASE=skyline_odoo
ODOO_USERNAME=integration@skyline.local
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=5000
