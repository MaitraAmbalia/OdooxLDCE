NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization
PEOPLE_DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization?schema=people
PLATFORM_DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization?schema=platform
COMMERCE_DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization?schema=commerce
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

# Use two distinct random secrets of at least 32 characters; required in production.
# Empty development secrets are generated per process, invalidating sessions/mail on restart.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COLLEGE_EMAIL_DOMAIN=nirmauni.ac.in
APP_TIMEZONE=Asia/Kolkata

# Mailpit SMTP defaults; configure your SMTP provider for production.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Skyline <no-reply@nirmauni.ac.in>

FILE_STORAGE=local
FILE_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=

# Razorpay test keys (https://dashboard.razorpay.com). Keep real values in .env, never here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
