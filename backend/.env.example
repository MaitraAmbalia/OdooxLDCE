NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

# Razorpay test keys (https://dashboard.razorpay.com). Keep real values in .env, never here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Uploaded files live here (local disk)
FILE_STORAGE_PATH=./storage
