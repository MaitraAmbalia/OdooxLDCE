NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/student_organization
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

# Payments: MOCK (default, no keys) or RAZORPAY (test keys from the Razorpay dashboard)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
