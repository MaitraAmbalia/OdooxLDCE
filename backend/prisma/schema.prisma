  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("volunteers")
}

model Project {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?        @db.Text
  type          ProjectType
  eventId       String?        @map("event_id") @db.Uuid
  goalPaise     BigInt?        @map("goal_paise")
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  status        ProjectStatus  @default(ACTIVE)
  ownerId       String         @map("owner_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks         Task[]
  ledgerEntries LedgerEntry[]
  expenseClaims ExpenseClaim[]

  @@index([status, type])
  @@index([eventId])
  @@map("projects")
}

model Task {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  title           String
  description     String?        @db.Text
  priority        TaskPriority
  status          TaskStatus     @default(TODO)
  dueAt           DateTime       @map("due_at") @db.Timestamptz(6)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdById     String         @map("created_by") @db.Uuid
  sourceMeetingId String?        @map("source_meeting_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceMeeting   Meeting?       @relation("MeetingCreatedTasks", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  assignees       TaskAssignee[]
  channel         ChatChannel?
  actionItem      ActionItem?
  expenseClaims   ExpenseClaim[]

  @@index([projectId, status])
  @@index([dueAt, status])
  @@map("tasks")
}

model TaskAssignee {
  id         String    @id @default(uuid()) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, userId, removedAt])
  @@index([userId, removedAt])
  @@map("task_assignees")
}

model ChatChannel {
  id         String        @id @default(uuid()) @db.Uuid
  taskId     String        @unique @map("task_id") @db.Uuid
  isReadOnly Boolean       @default(false) @map("is_read_only")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  messages   ChatMessage[]

  @@map("chat_channels")
}

model ChatMessage {
  id          String      @id @default(uuid()) @db.Uuid
  channelId   String      @map("channel_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  body        String      @db.Text
  clientMsgId String      @map("client_msg_id")
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([senderId, clientMsgId])
  @@index([channelId, createdAt])
  @@map("chat_messages")
}

model Meeting {
  id           String              @id @default(uuid()) @db.Uuid
  title        String
  startAt      DateTime            @map("start_at") @db.Timestamptz(6)
  endAt        DateTime            @map("end_at") @db.Timestamptz(6)
  location     String?
  meetingLink  String?             @map("meeting_link")
  audience     MeetingAudience
  status       MeetingStatus       @default(SCHEDULED)
  cancelReason String?             @map("cancel_reason") @db.Text
  createdById  String              @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    User                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  agendaItems  AgendaItem[]
  invites      MeetingInvite[]
  attendance   MeetingAttendance[]
  minutes      MeetingMinutes?
  actionItems  ActionItem[]
  createdTasks Task[]              @relation("MeetingCreatedTasks")
  interviews   Application[]       @relation("ApplicationInterview")

  @@index([status, startAt])
  @@map("meetings")
}

model AgendaItem {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  sortOrder   Int      @map("sort_order")
  topic       String
  ownerId     String?  @map("owner_id") @db.Uuid
  durationMin Int      @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner       User?    @relation("AgendaOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([meetingId, sortOrder])
  @@map("agenda_items")
}

model MeetingInvite {
  id          String      @id @default(uuid()) @db.Uuid
  meetingId   String      @map("meeting_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  isRequired  Boolean     @default(false) @map("is_required")
  rsvp        MeetingRsvp @default(PENDING)
  rsvpNote    String?     @map("rsvp_note") @db.Text
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting     Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId])
  @@index([userId, rsvp])
  @@map("meeting_invites")
}

model MeetingAttendance {
  id         String   @id @default(uuid()) @db.Uuid
  meetingId  String   @map("meeting_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  present    Boolean
  markedById String   @map("marked_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User     @relation("MeetingAttendee", fields: [userId], references: [id], onDelete: Restrict)
  markedBy   User     @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId])
  @@map("meeting_attendance")
}

model MeetingMinutes {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @unique @map("meeting_id") @db.Uuid
  summaryMd String   @map("summary_md") @db.Text
  decisions Json     @db.JsonB
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author    User     @relation("MeetingMinutesAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("meeting_minutes")
}

model ActionItem {
  id         String   @id @default(uuid()) @db.Uuid
  meetingId  String   @map("meeting_id") @db.Uuid
  title      String
  assigneeId String   @map("assignee_id") @db.Uuid
  dueAt      DateTime @map("due_at") @db.Timestamptz(6)
  taskId     String?  @unique @map("task_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User     @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([assigneeId, dueAt])
  @@map("action_items")
}

// Temporary door access granted by the Event Head for one event (check-in + membership verify).
model EventDoorStaff {
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation("DoorStaff", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("DoorStaffAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_door_staff")
}
