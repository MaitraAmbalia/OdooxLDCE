generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ===== Person B =====

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  PASSWORD_RESET
  ADMIN_REVOKED
}

enum Role {
  USER
  MEMBER
  VOLUNTEER
  TASK_ASSIGNEE
  DOOR_VOLUNTEER
  CASH_DESK
  VOLUNTEER_HEAD
  EVENT_HEAD
  MARKETING_HEAD
  SPONSORSHIP_HEAD
  TREASURER
  PRESIDENT
  MENTOR
}

enum LeadershipRole {
  VOLUNTEER_HEAD
  EVENT_HEAD
  MARKETING_HEAD
  SPONSORSHIP_HEAD
  TREASURER
  PRESIDENT
}

enum ScopeType {
  EVENT
  TASK
  MEMBERSHIP_DRIVE
}

enum RoleAssignmentSource {
  SELECTION
  MANUAL
  SYSTEM
}

enum MembershipDurationType {
  ACADEMIC_YEAR
  SEMESTER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  LAPSED
  CANCELLED
}

enum MembershipSource {
  ONLINE
  CASH
}

enum CashCollectionPurpose {
  MEMBERSHIP
  TICKET
  FUNDRAISER
  MERCH
}

enum CashCollectionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum EventVisibility {
  PUBLIC
  MEMBERS_ONLY
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CLOSED
  CANCELLED
  REJECTED
}

enum EventReviewDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

enum TicketAudience {
  MEMBER
  NON_MEMBER
  ALL
}

enum TicketReservationStatus {
  HELD
  CONVERTED
  RELEASED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  REFUNDED
  CANCELLED
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerCategory {
  DUES
  TICKETS
  MERCH
  FUNDRAISER
  BUDGET_ALLOCATION
  SPONSORSHIP
  REIMBURSEMENT
  PURCHASE
  REFUND
  OTHER
}

enum LedgerSourceType {
  PAYMENT
  CASH_COLLECTION
  CLAIM
  ALLOCATION
  SPONSORSHIP_COMMITMENT
  MANUAL
  REVERSAL
  REFUND
}

enum LedgerEntryStatus {
  COMMITTED
  POSTED
}

enum BudgetAllocationSource {
  UNIVERSITY_GRANT
  CARRY_FORWARD
  OTHER
}

enum ExpenseClaimStatus {
  SUBMITTED
  APPROVED_L1
  APPROVED
  REJECTED
  PAID
  WITHDRAWN
}

enum ExpenseClaimRoute {
  STANDARD
  HIGH_VALUE
  TREASURER_SELF
}

enum ClaimDecisionLevel {
  L1
  L2
}

enum ClaimDecisionValue {
  APPROVE
  REJECT
}

enum SelectionCycleStatus {
  DRAFT
  OPEN
  CLOSED
  UNDER_REVIEW
  PUBLISHED
}

enum SelectionQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum ApplicationStatus {
  SUBMITTED
  WITHDRAWN
  SHORTLISTED
  INTERVIEW
  REJECTED
  APPOINTED
}

enum PaymentPurpose {
  MEMBERSHIP
  TICKET
  MERCH_ORDER
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  MOCK
}

enum FilePurpose {
  RECEIPT
  MERCH_IMAGE
  EVENT_COVER
  AVATAR
  APPLICATION_ATTACHMENT
  LEDGER_ATTACHMENT
}

enum EmailOutboxStatus {
  QUEUED
  SENT
  FAILED
}

enum ApprovalType {
  MERCH_PRICE
  TIER_PRICE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_PRICE_APPROVAL
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  READY
  COLLECTED
  CANCELLED
  REFUNDED
}

enum AnnouncementAudience {
  PUBLIC
  MEMBERS
  EVENT_ATTENDEES
  LEADERS
  VOLUNTEERS
}

enum AnnouncementChannel {
  WEB
  EMAIL
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum NewsletterSubscriberStatus {
  PENDING_CONFIRMATION
  SUBSCRIBED
  UNSUBSCRIBED
}

enum NewsletterConsentAction {
  OPT_IN
  CONFIRM
  OPT_OUT
}

enum NewsletterConsentSource {
  SIGNUP_FORM
  PROFILE
  EMAIL_LINK
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
}

enum ProjectType {
  FUNDRAISER
  EVENT_PREP
  OTHER
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum MeetingAudience {
  LEADERS
  VOLUNTEERS
  BOTH
  CUSTOM
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum MeetingRsvp {
  PENDING
  YES
  NO
  MAYBE
}

// ===== Person B: Core Platform & Governance =====

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.Citext
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  passwordHash            String                   @map("password_hash")
  name                    String
  studentId               String                   @unique @map("student_id")
  phone                   String?
  avatarFileId            String?                  @map("avatar_file_id") @db.Uuid
  isDisabled              Boolean                  @default(false) @map("is_disabled")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens           RefreshToken[]
  emailTokens             EmailToken[]
  roleAssignments         RoleAssignment[]         @relation("RoleAssignmentUser")
  createdRoleAssignments  RoleAssignment[]         @relation("RoleAssignmentCreator")
  memberships             Membership[]
  proposedEvents          Event[]                  @relation("EventProposer")
  approvedEvents          Event[]                  @relation("EventApprover")
  eventReviews            EventReview[]
  ticketReservations      TicketReservation[]
  tickets                 Ticket[]                 @relation("TicketOwner")
  checkedInTickets        Ticket[]                 @relation("TicketCheckInUser")
  ledgerEntries           LedgerEntry[]            @relation("LedgerRecorder")
  budgetAllocations       BudgetAllocation[]
  collectedCash           CashCollection[]         @relation("CashCollector")
  paidCash                CashCollection[]         @relation("CashPayer")
  verifiedCash            CashCollection[]         @relation("CashVerifier")
  expenseClaims           ExpenseClaim[]           @relation("ClaimSubmitter")
  claimDecisions          ClaimDecision[]          @relation("ClaimDecider")
  selectionCycles         SelectionCycle[]         @relation("SelectionCycleCreator")
  applications            Application[]            @relation("ApplicationApplicant")
  appointments            Appointment[]            @relation("AppointmentCreator")
  updatedSettings         Setting[]                @relation("SettingUpdater")
  auditLogs               AuditLog[]               @relation("AuditActor")
  idempotencyKeys         IdempotencyKey[]
  avatarFile              File?                    @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  ownedFiles              File[]                   @relation("FileOwner")
  payments                Payment[]
  notifications           Notification[]
  requestedApprovals      Approval[]               @relation("ApprovalRequester")
  decidedApprovals        Approval[]               @relation("ApprovalDecider")
  stockAdjustments        StockAdjustment[]        @relation("StockAdjuster")
  orders                  Order[]                  @relation("OrderOwner")
  collectedOrders         Order[]                  @relation("OrderCollector")
  announcements           Announcement[]           @relation("AnnouncementAuthor")
  announcementCorrections AnnouncementCorrection[] @relation("AnnouncementCorrectionAuthor")
  newsletterSubscription  NewsletterSubscriber?
  newsletterCampaigns     NewsletterCampaign[]     @relation("NewsletterCampaignAuthor")
  volunteer               Volunteer?
  ownedProjects           Project[]                @relation("ProjectOwner")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskAssignments         TaskAssignee[]
  chatMessages            ChatMessage[]
  createdMeetings         Meeting[]                @relation("MeetingCreator")
  agendaItems             AgendaItem[]             @relation("AgendaOwner")
  meetingInvites          MeetingInvite[]
  meetingAttendance       MeetingAttendance[]      @relation("MeetingAttendee")
  markedAttendance        MeetingAttendance[]      @relation("AttendanceMarker")
  meetingMinutes          MeetingMinutes[]         @relation("MeetingMinutesAuthor")
  actionItems             ActionItem[]             @relation("ActionItemAssignee")

  doorShifts      EventDoorStaff[] @relation("DoorStaff")
  doorAssignments EventDoorStaff[] @relation("DoorStaffAssigner")

  @@map("users")
}

model RefreshToken {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  familyId      String                    @map("family_id") @db.Uuid
  parentTokenId String?                   @map("parent_token_id") @db.Uuid
  tokenHash     String                    @unique @map("token_hash")
  expiresAt     DateTime                  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokeReason  RefreshTokenRevokeReason? @map("revoke_reason")
  userAgent     String?                   @map("user_agent")
  ip            String?                   @db.Inet
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        RefreshToken?             @relation("RefreshRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  children      RefreshToken[]            @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_tokens")
}

model RoleAssignment {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        Role
  scopeType   ScopeType?           @map("scope_type")
  scopeId     String?              @map("scope_id") @db.Uuid
  termStart   DateTime             @map("term_start") @db.Timestamptz(6)
  termEnd     DateTime             @map("term_end") @db.Timestamptz(6)
  endedAt     DateTime?            @map("ended_at") @db.Timestamptz(6)
  source      RoleAssignmentSource
  createdById String               @map("created_by") @db.Uuid
  reason      String
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User                 @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("RoleAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  appointment Appointment?         @relation("AppointmentRoleAssignment")

  @@index([userId, role, scopeType, scopeId])
  @@index([role, termStart, termEnd, endedAt])
  @@map("role_assignments")
}

model MembershipTier {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String                 @unique
  pricePaise   BigInt                 @map("price_paise")
  durationType MembershipDurationType @map("duration_type")
  benefits     Json                   @default("{}") @db.JsonB
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]

  @@map("membership_tiers")
}

model Membership {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  tierId            String           @map("tier_id") @db.Uuid
  status            MembershipStatus @default(PENDING)
  startsAt          DateTime?        @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz(6)
  source            MembershipSource
  paymentId         String?          @map("payment_id") @db.Uuid
  cashCollectionId  String?          @unique @map("cash_collection_id") @db.Uuid
  cardSecretVersion Int              @default(1) @map("card_secret_version")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  tier              MembershipTier   @relation(fields: [tierId], references: [id], onDelete: Restrict)
  cashCollection    CashCollection?  @relation("MembershipCashCollection", fields: [cashCollectionId], references: [id], onDelete: Restrict)
  payment           Payment?         @relation("MembershipPayment", fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([tierId, status])
  @@map("memberships")
}

model CashCollection {
  id            String                @id @default(uuid()) @db.Uuid
  collectedById String                @map("collected_by") @db.Uuid
  purpose       CashCollectionPurpose
  refId         String                @map("ref_id") @db.Uuid
  payerUserId   String?               @map("payer_user_id") @db.Uuid
  amountPaise   BigInt                @map("amount_paise")
  status        CashCollectionStatus  @default(PENDING_VERIFICATION)
  verifiedById  String?               @map("verified_by") @db.Uuid
  verifiedAt    DateTime?             @map("verified_at") @db.Timestamptz(6)
  rejectReason  String?               @map("reject_reason")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  collectedBy   User                  @relation("CashCollector", fields: [collectedById], references: [id], onDelete: Restrict)
  payer         User?                 @relation("CashPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  verifiedBy    User?                 @relation("CashVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  membership    Membership?           @relation("MembershipCashCollection")

  @@index([status, createdAt])
  @@index([purpose, refId])
  @@map("cash_collections")
}

model Event {
  id                     String            @id @default(uuid()) @db.Uuid
  title                  String
  description            String            @db.Text
  category               String
  venue                  String
  startAt                DateTime          @map("start_at") @db.Timestamptz(6)
  endAt                  DateTime          @map("end_at") @db.Timestamptz(6)
  capacity               Int
  seatsSold              Int               @default(0) @map("seats_sold")
  visibility             EventVisibility   @default(PUBLIC)
  status                 EventStatus       @default(DRAFT)
  volunteersNeeded       Int               @default(0) @map("volunteers_needed")
  logisticsNotes         String?           @map("logistics_notes") @db.Text
  coverFileId            String?           @map("cover_file_id") @db.Uuid
  approvedBudgetPaise    BigInt?           @map("approved_budget_paise")
  sponsorshipRequired    Boolean           @default(false) @map("sponsorship_required")
  sponsorshipTargetPaise BigInt?           @map("sponsorship_target_paise")
  sponsorshipDeadline    DateTime?         @map("sponsorship_deadline") @db.Timestamptz(6)
  sponsorshipPitch       String?           @map("sponsorship_pitch") @db.Text
  sponsorshipPackages    Json?             @map("sponsorship_packages") @db.JsonB
  sponsorBenefits        String?           @map("sponsor_benefits") @db.Text
  proposedById           String            @map("proposed_by") @db.Uuid
  approvedById           String?           @map("approved_by") @db.Uuid
  approvedAt             DateTime?         @map("approved_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  proposedBy             User              @relation("EventProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  approvedBy             User?             @relation("EventApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  budgetLines            EventBudgetLine[]
  reviews                EventReview[]
  ticketTypes            TicketType[]
  tickets                Ticket[]
  ledgerEntries          LedgerEntry[]
  expenseClaims          ExpenseClaim[]
  coverFile              File?             @relation("EventCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  projects               Project[]
  announcements          Announcement[]
  doorStaff              EventDoorStaff[]

  @@index([status, startAt])
  @@index([visibility, status, startAt])
  @@map("events")
}

model EventBudgetLine {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  category    String
  amountPaise BigInt   @map("amount_paise")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_budget_lines")
}

model EventReview {
  id         String              @id @default(uuid()) @db.Uuid
  eventId    String              @map("event_id") @db.Uuid
  reviewerId String              @map("reviewer_id") @db.Uuid
  decision   EventReviewDecision
  comment    String?             @db.Text
  snapshot   Json                @db.JsonB
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewer   User                @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@map("event_reviews")
}

model TicketType {
  id           String              @id @default(uuid()) @db.Uuid
  eventId      String              @map("event_id") @db.Uuid
  name         String
  audience     TicketAudience
  pricePaise   BigInt              @map("price_paise")
  quota        Int
  sold         Int                 @default(0)
  maxPerUser   Int                 @map("max_per_user")
  salesStartAt DateTime            @map("sales_start_at") @db.Timestamptz(6)
  salesEndAt   DateTime            @map("sales_end_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reservations TicketReservation[]
  tickets      Ticket[]

  @@index([eventId, audience])
  @@map("ticket_types")
}

model TicketReservation {
  id           String                  @id @default(uuid()) @db.Uuid
  ticketTypeId String                  @map("ticket_type_id") @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  quantity     Int
  paymentId    String?                 @map("payment_id") @db.Uuid
  expiresAt    DateTime                @map("expires_at") @db.Timestamptz(6)
  status       TicketReservationStatus @default(HELD)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  ticketType   TicketType              @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment      Payment?                @relation("ReservationPayment", fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([userId, ticketTypeId, status])
  @@map("ticket_reservations")
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  ticketTypeId   String       @map("ticket_type_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  pricePaidPaise BigInt       @map("price_paid_paise")
  status         TicketStatus @default(ISSUED)
  checkedInAt    DateTime?    @map("checked_in_at") @db.Timestamptz(6)
  checkedInById  String?      @map("checked_in_by") @db.Uuid
  paymentId      String?      @map("payment_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  user           User         @relation("TicketOwner", fields: [userId], references: [id], onDelete: Restrict)
  checkedInBy    User?        @relation("TicketCheckInUser", fields: [checkedInById], references: [id], onDelete: Restrict)
  payment        Payment?     @relation("TicketPayment", fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([ticketTypeId, status])
  @@map("tickets")
}

model LedgerEntry {
  id               String            @id @default(uuid()) @db.Uuid
  direction        LedgerDirection
  category         LedgerCategory
  amountPaise      BigInt            @map("amount_paise")
  sourceType       LedgerSourceType  @map("source_type")
  status           LedgerEntryStatus @default(POSTED)
  sourceId         String            @map("source_id") @db.Uuid
  eventId          String?           @map("event_id") @db.Uuid
  projectId        String?           @map("project_id") @db.Uuid
  description      String            @db.Text
  occurredAt       DateTime          @map("occurred_at") @db.Timestamptz(6)
  recordedById     String?           @map("recorded_by") @db.Uuid
  reversesEntryId  String?           @unique @map("reverses_entry_id") @db.Uuid
  attachmentFileId String?           @map("attachment_file_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  attachmentFile   File?             @relation("LedgerAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict)
  event            Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recordedBy       User?             @relation("LedgerRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reversesEntry    LedgerEntry?      @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy       LedgerEntry?      @relation("LedgerReversal")
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([occurredAt])
  @@index([eventId, occurredAt])
  @@index([projectId, occurredAt])
  @@map("ledger_entries")
}

model BudgetAllocation {
  id            String                 @id @default(uuid()) @db.Uuid
  period        String
  amountPaise   BigInt                 @map("amount_paise")
  source        BudgetAllocationSource
  note          String?                @db.Text
  allocatedById String                 @map("allocated_by") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  allocatedBy   User                   @relation(fields: [allocatedById], references: [id], onDelete: Restrict)

