generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/people-client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("PEOPLE_DATABASE_URL")
  extensions = [citext(schema: "public")]
}

enum TermRole {
  MENTOR
  PRESIDENT
  TREASURER
  EVENT_HEAD
  VOLUNTEER_HEAD
  MARKETING_HEAD
}

enum RoleAssignmentSource {
  SELECTION
  MANUAL
  SYSTEM
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum RefreshTokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  PASSWORD_RESET
  ADMIN_REVOKED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.Citext
  emailVerifiedAt      DateTime?             @map("email_verified_at") @db.Timestamptz(6)
  passwordHash         String                @map("password_hash")
  name                 String
  studentId            String                @unique @map("student_id")
  phone                String?
  avatarFileId         String?               @map("avatar_file_id") @db.Uuid
  isDisabled           Boolean               @default(false) @map("is_disabled")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens        RefreshToken[]
  emailTokens          EmailToken[]
  assignments          RoleAssignment[]      @relation("RoleHolder")
  createdAssignments   RoleAssignment[]      @relation("RoleCreator")
  volunteer            Volunteer?
  files                PeopleFile[]          @relation("FileOwner")
  avatar               PeopleFile?           @relation("Avatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  newsletterSubscriber NewsletterSubscriber?

  @@map("users")
}

model RefreshToken {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  familyId      String                    @map("family_id") @db.Uuid
  parentTokenId String?                   @map("parent_token_id") @db.Uuid
  tokenHash     String                    @unique @map("token_hash")
  expiresAt     DateTime                  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  revokeReason  RefreshTokenRevokeReason? @map("revoke_reason")
  userAgent     String?                   @map("user_agent")
  ip            String?                   @db.Inet
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        RefreshToken?             @relation("RefreshRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  children      RefreshToken[]            @relation("RefreshRotation")

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  purpose        EmailTokenPurpose
  tokenHash      String            @unique @map("token_hash")
  codeHash       String?           @map("code_hash")
  failedAttempts Int               @default(0) @map("failed_attempts")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?         @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_tokens")
}

model RoleAssignment {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        TermRole
  termStart   DateTime             @map("term_start") @db.Timestamptz(6)
  termEnd     DateTime             @map("term_end") @db.Timestamptz(6)
  endedAt     DateTime?            @map("ended_at") @db.Timestamptz(6)
  source      RoleAssignmentSource
  createdById String               @map("created_by") @db.Uuid
  reason      String
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User                 @relation("RoleHolder", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("RoleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, role])
  @@index([role, termStart, termEnd, endedAt])
  @@map("role_assignments")
}

enum PeopleFilePurpose {
  AVATAR
  APPLICATION_ATTACHMENT
}

enum EmailOutboxStatus {
  QUEUED
  SENT
  FAILED
}

enum NewsletterSubscriberStatus {
  PENDING_CONFIRMATION
  SUBSCRIBED
  UNSUBSCRIBED
}

model PeopleFile {
  id         String            @id @default(uuid()) @db.Uuid
  ownerId    String            @map("owner_id") @db.Uuid
  purpose    PeopleFilePurpose
  storageKey String            @unique @map("storage_key")
  mimeType   String            @map("mime_type")
  byteSize   Int               @map("byte_size")
  sha256     String
  attachedAt DateTime?         @map("attached_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  owner      User              @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  avatars    User[]            @relation("Avatar")

  @@index([ownerId, createdAt])
  @@map("files")
}

model Volunteer {
  userId    String   @id @map("user_id") @db.Uuid
  status    String   @default("ACTIVE")
  skills    String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteers")
}

model EmailOutbox {
  id        String            @id @default(uuid()) @db.Uuid
  to        String
  template  String
  payload   Json
  status    EmailOutboxStatus @default(QUEUED)
  attempts  Int               @default(0)
  lastError String?           @map("last_error")
  sendAfter DateTime          @default(now()) @map("send_after") @db.Timestamptz(6)
  sentAt    DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, sendAfter])
  @@map("email_outbox")
}

model NewsletterSubscriber {
  id                   String                     @id @default(uuid()) @db.Uuid
  email                String                     @unique @db.Citext
  userId               String?                    @unique @map("user_id") @db.Uuid
  name                 String
  status               NewsletterSubscriberStatus @default(PENDING_CONFIRMATION)
  confirmTokenHash     String?                    @map("confirm_token_hash")
  confirmExpiresAt     DateTime?                  @map("confirm_expires_at") @db.Timestamptz(6)
  unsubscribeTokenHash String                     @unique @map("unsubscribe_token_hash")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  consents             NewsletterConsent[]

  @@map("newsletter_subscribers")
}

model NewsletterConsent {
  id           String               @id @default(uuid()) @db.Uuid
  subscriberId String               @map("subscriber_id") @db.Uuid
  action       String
  source       String
  ip           String?              @db.Inet
  userAgent    String?              @map("user_agent")
  at           DateTime             @default(now()) @db.Timestamptz(6)
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@map("newsletter_consents")
}
