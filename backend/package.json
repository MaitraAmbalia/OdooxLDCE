{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src eslint.config.js",
    "db:validate": "node scripts/schema.js validate",
    "db:format": "node scripts/schema.js format",
    "db:generate": "node scripts/schema.js generate",
    "db:deploy": "node scripts/schema.js deploy",
    "emit": "node scripts/emit.js",
    "members:fixtures": "node scripts/member-fixtures.js",
    "people:seed": "node prisma/people/seed.js",
    "people:validate": "prisma validate --schema prisma/people/schema.prisma",
    "people:format": "prisma format --schema prisma/people/schema.prisma",
    "people:generate": "prisma generate --schema prisma/people/schema.prisma",
    "people:migrate": "prisma migrate dev --schema prisma/people/schema.prisma",
    "people:deploy": "prisma migrate deploy --schema prisma/people/schema.prisma",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
